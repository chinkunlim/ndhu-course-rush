# NDHU Course Selector Configuration Example
# 複製此檔案為 .env 並填寫您的東華大學選課系統帳號與密碼

# 學生證學號 (例如 411383000)
NDHU_USERNAME=your_student_id_here

# 選課系統密碼
NDHU_PASSWORD=your_password_here

# 選課系統登入頁面網址 (預設為東華大學正式選課系統)
LOGIN_URL=https://sys.ndhu.edu.tw/aa/class/subjselect/course_sele.aspx

# 搶課微延遲微調 (秒，預設 0.05 秒)
RUSH_DELAY=0.05

# 查詢階段延遲微調 (秒，預設 0.15 秒)
QUERY_DELAY=0.15
