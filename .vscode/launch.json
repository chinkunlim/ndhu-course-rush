{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run Course Selector",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/auto_login.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Python: Run Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal"
    }
  ]
}
